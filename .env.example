# Optional settings. Copy this file to .env to use them; docker compose reads .env automatically.
# Leave ANTHROPIC_API_KEY empty to run the offline engine (everything except open questions works).
ANTHROPIC_API_KEY=

# Claude model for open questions, fresh explanations and grading.
# claude-haiku-5-5 is a faster, lower-cost option.
AI_MODEL=claude-opus-5-5

# Host port, if 8080 is already in use on your machine.
HOST_PORT=8080
